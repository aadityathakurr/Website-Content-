        "default": "<p>#1 choice for Apache OFBiz development &amp; support. Build custom supply chain software faster with OFBiz, Solr, NiFi, Superset, and Moqui.</p>"
      }
    ]
  },
  {
    "name": "cta_group",
    "label": "Buttons",
    "type": "group",
    "expanded": true,
    "children": [
