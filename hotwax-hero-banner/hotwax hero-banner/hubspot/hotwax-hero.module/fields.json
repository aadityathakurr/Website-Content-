        "name": "line_1",
        "label": "Line 1",
        "type": "text",
        "required": true,
        "default": "Let's Accomplish"
      },
      {
        "name": "line_2",
        "label": "Line 2 (accent colour)",
        "help_text": "Leave empty for a single-line headline.",
        "type": "text",
        "default": "Great Together"
      },
      {
        "name": "subhead",
        "label": "Sub-headline",
