    "default": [
      {
        "cred_text": "<p>Led by the <b>Apache OFBiz PMC Chair</b></p>"
      },
      {
        "cred_text": "<p><b>PMC members and committers</b> with write access to the Apache OFBiz codebase</p>"
      },
      {
        "cred_text": "<p>Every Apache role is <b>public on apache.org</b></p>"
