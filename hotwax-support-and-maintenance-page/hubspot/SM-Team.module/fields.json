  {
    "type": "group",
    "name": "carousel",
    "label": "Carousel behavior",
    "expanded": false,
    "children": [
      {
        "id": "sm_team_cards_visible",
        "name": "cards_visible",
        "label": "Cards visible at once (desktop)",
        "type": "choice",
        "display": "select",
        "required": false,
        "locked": false,
        "help_text": "Tablets show at most 2 cards and phones show 1.",
        "choices": [
          [
            "4",
            "4"
          ],
          [
            "3",
            "3"
          ],
          [
            "2",
            "2"
          ],
          [
            "1",
            "1"
          ]
        ],
        "default": "3"
      },
      {
        "type": "boolean",
        "name": "autoplay",
        "label": "Auto-advance (one card at a time)",
        "display": "toggle",
        "default": true,
        "help_text": "Pauses while the visitor hovers or uses the keyboard."
      },
      {
        "type": "number",
        "name": "interval",
        "label": "Seconds per card",
        "display": "slider",
        "min": 2,
        "max": 15,
        "step": 1,
        "suffix": "s",
        "default": 4,
        "visibility": {
          "controlling_field_path": "carousel.autoplay",
          "controlling_value_regex": "true",
          "operator": "EQUAL"
        },
        "help_text": "How long the row waits before moving one card."
      },
      {
        "type": "boolean",
        "name": "show_arrows",
        "label": "Show arrows (tablets and desktop; phones use swipe)",
        "display": "toggle",
        "default": true
      },
      {
        "type": "boolean",
        "name": "swipe",
        "label": "Swipe on touch screens",
        "display": "toggle",
        "default": true
      }
    ]
  },
  {
    "type": "text",
    "name": "section_id",
    "label": "Section ID (anchor)",
